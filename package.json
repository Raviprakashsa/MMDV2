        "test:visual:approve": "npx backstop approve",
        "test:layout": "npx galen check tests/gl/leads.gspec --url http://localhost:3000/dashboard/leads --size 1280x800",
        "test:role-matrix": "node scripts/role-matrix-runtime-test-v3.mjs",
        "test:smoke": "npx playwright test tests/integration/smoke.spec.ts --reporter=list",
        "test:integration": "npx playwright test --reporter=list",
        "migrate": "migrate-mongo up",
        "migrate:status": "migrate-mongo status"
