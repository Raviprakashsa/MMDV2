        "release:check": "npm run typecheck && npm run lint && npm run build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "clean:ui": "eslint app components --fix || true",
        "db:seed": "tsx lib/db/seed.ts",
        "db:seed:prisma": "tsx prisma/seed.ts",
        "db:seed:test-users": "tsx prisma/seed-test-users.ts",
