# Copy to .env and fill values before running locally or in Docker
NEXTAUTH_SECRET=your_long_random_secret_here
DATABASE_URL=mongodb://localhost:27017/mmdss
POSTGRES_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mmd_v2?schema=public
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=production

# Sentry error monitoring (optional but required for production observability)
# Obtain the DSN from your Sentry project settings → Client Keys.
# Leave blank to disable Sentry (app will continue to work normally).
SENTRY_DSN=
SENTRY_RELEASE=

# Storage provider (A0 foundation)
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=.storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# MMDSS environment configuration
# Copy to .env.local for development or configure these values in your hosting platform.

# Database
DATABASE_URL="mongodb://localhost:27017/mmdss"
# DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/mmdss"

# Application URLs
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"

# Required production secrets
# Generate strong random values before deployment.
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
AUTH_SECRET="replace-with-the-same-or-another-strong-random-secret"
CRON_SECRET="replace-with-a-strong-random-bearer-token"
DOCUMENT_DOWNLOAD_SECRET="replace-with-a-strong-random-signing-secret"

# Distributed throttling for multi-instance production.
# Use memory only for local development or single-instance pre-production.
THROTTLE_BACKEND="redis"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Demo/dev UI controls
# Keep false in production. Use the seed script or admin UI to create real users.
NEXT_PUBLIC_SHOW_TEST_ACCOUNTS="false"

# Optional feature flags
FEATURE_MANAGED_DOCUMENT_STORAGE="true"
FEATURE_CANDIDATE_JOINED_TXN="true"
FEATURE_SEARCH_RBAC_STRICT_MODE="true"

# Optional dashboard thresholds
DASHBOARD_STALLED_DAYS="15"
DASHBOARD_RECENT_ACTIVITY_DAYS="7"
DASHBOARD_IDLE_ACTIVITY_HOURS="48"
DASHBOARD_MOU_EXPIRY_DAYS="30"
DASHBOARD_OFFER_STUCK_DAYS="14"
DASHBOARD_RED_ZONE_RECENCY_DAYS="7"

# Optional audit smoke-test credentials
AUDIT_EMAIL=""
AUDIT_PASSWORD=""

# Integration-test credentials. Prefer explicit values in CI/staging.
# Set E2E_USE_SEEDED_USERS="1" only when the database has been populated by npm run db:seed.
E2E_USE_SEEDED_USERS="0"
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
E2E_SUPER_ADMIN_EMAIL=""
E2E_SUPER_ADMIN_PASSWORD=""
E2E_COORDINATOR_EMAIL=""
E2E_COORDINATOR_PASSWORD=""
E2E_RECRUITER_EMAIL=""
E2E_RECRUITER_PASSWORD=""
E2E_SCRAPER_EMAIL=""
E2E_SCRAPER_PASSWORD=""
